        "predPlot = (pl.from_pandas(predTable[['crew', 'mean', 'obs_ci_lower', 'obs_ci_upper']])\n",
        "  .with_columns(real = pl.col('crew') == 'Actual crew (Oct 13)')\n",
        ")\n",
        "\n",
        "(ggplot(predPlot, aes(x = 'mean', y = 'crew', color = 'real'))\n",
        "  + geom_vline(xintercept = actualFouls, color = 'red', linetype = '--')\n",
        "  + geom_errorbarh(aes(xmin = 'obs_ci_lower', xmax = 'obs_ci_upper'), height = 0.2)\n",
        "  + geom_point(size = 3)\n",
        "  + geom_text(aes(label = 'mean'), format_string = '{:.0f} fouls', nudge_y = 0.3)\n",
        "  + scale_color_manual(values = {True: nbaGreen, False: 'grey'}, guide = None)\n",
        "  + scale_y_discrete(limits = rowNames[::-1])\n",
        "  + labs(x = 'Predicted total fouls (95% prediction interval)', y = '',\n",
        "         title = 'Predicted 39, actual 50: inside our range')\n",
        "  + nbaTheme\n",
        ")"
      ],
      "id": "78385dc5",
