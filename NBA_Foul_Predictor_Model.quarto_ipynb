{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"NBA Foul Predictor\"\n",
        "format: typst\n",
        "---\n",
        "\n",
        "## Imports"
      ],
      "id": "c0abc3d3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "import polars as pl\n",
        "from pyprojroot.here import here"
      ],
      "id": "61f91590",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Combining the Referee Stats Files Into One Table\n",
        "```{pytfilehon}\n",
        "seasons = ['2017-2018', '2018-2019', '2019-2020', '2020-2021', '2021-2022', '2022-2023', '2023-2024', '2024-2025', '2025-2026']\n",
        "\n",
        "refList = []\n",
        "for s in seasons:\n",
        "    fileName = f'nba_referee_stats_{s}.csv'\n",
        "    if s == '2025-2026':\n",
        "        fileName = 'nba_referee_stats_2025_2026.csv' ## uses an underscore instead of dash between years\n",
        "    \n",
        "    refSeason = pl.read_csv(here(f'Data/{fileName}'))\n",
        "\n",
        "## find foul differential column\n",
        "    diffCol = [c for c in refSeason.columns if 'FOUL DIFFERENTIAL' in c][0]\n",
        "\n",
        "    refSeason = (refSeason\n",
        "        .rename({diffCol: 'foul_diff'})\n",
        "        .rename({'TYPE': 'ROLE'}, strict = False) ## older files say TYPE\n",
        "        .drop(['RANK', 'Unnamed: 13'], strict = False) ## empty columns\n",
        "        .with_columns(Season = pl.lit(s)) ## adds Season if missing\n",
        "        )\n",
        "    refList.append(refSeason)\n",
        "\n",
        "## Stack all seasons\n",
        "refStats = pl.concat(refList, how = 'diagonal')\n",
        "\n",
        "## Renaming columns\n",
        "refStats = refStats.rename({\n",
        "    'Season': 'season', 'REFEREE': 'referee', 'ROLE': 'role', 'GENDER': 'gender', 'EXPERIENCE (YEARS)': 'experience', 'GAMES OFFICIATED': 'games', 'HOME TEAM WIN%': 'home_win_pct', 'HOME TEAM POINTS DIFFERENTIAL': 'home_pt_diff', 'TOTAL POINTS PER GAME': 'points_per_game', 'CALLED FOULS PER GAME': 'fouls_per_game', 'FOUL% AGAINST ROAD TEAMS': 'foul_pct_road', 'FOUL% AGAINST HOME TEAMS': 'foul_pct_home',\n",
        "})\n",
        "\n",
        "## Fixing percents\n",
        "refStats = refStats.with_columns(\n",
        "    pl.when(pl.col(c) > 1).then(pl.col(c) / 100).otherwise(pl.col(c)).alias(c)\n",
        "    for c in ['foul_pct_road', 'foul_pct_home']\n",
        ")\n",
        "\n",
        "refStats\n",
        "```\n",
        "\n",
        "## Combine CHEIF and CREW Rows"
      ],
      "id": "d5cc59d3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "avgCols = ['home_win_pct', 'home_pt_diff', 'points_per_game', 'fouls_per_game', 'foul_pct_road', 'foul_pct_home', 'foul_diff']\n",
        "\n",
        "refStats = (refStats\n",
        "    .group_by(['season', 'referee']) ## referee rows for a season together\n",
        "    .agg(\n",
        "        experience = pl.col('experience').max(),\n",
        "        gender = pl.col('gender').first(),\n",
        "        games = pl.col('games').sum(), ## adding them\n",
        "        *[((pl.col(c) * pl.col('games')).sum() / pl.col('games').sum()).alias(c) for c in avgCols] ## weighted average for every column in avgCols\n",
        "    )\n",
        "    .sort(['season', 'referee'])\n",
        ")\n",
        "refStats"
      ],
      "id": "ce6e3ebb",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cleaning Games File"
      ],
      "id": "2ed52604"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "games = pl.read_csv(here('Data/nba_games_ref_assignments.csv'))\n",
        "\n",
        "games = (games\n",
        "    ## Spliting season code (22025 --> game type 2, start year 2025)\n",
        "    .with_columns(\n",
        "        game_type = pl.col('season') // 10000,\n",
        "        start_year = pl.col('season') % 10000,\n",
        "    )\n",
        "    ## Make it look like the referee table above ('2025-2026')\n",
        "    .with_columns(\n",
        "        season = pl.col('start_year').cast(pl.String) + '-' + (pl.col('start_year') + 1).cast(pl.String)\n",
        "    )\n",
        "    ## Keep only regular season games (2017-18)\n",
        "    .filter(pl.col('game_type') == 2, pl.col('start_year') >= 2017)\n",
        "    ## Fix team names\n",
        "    .with_columns(\n",
        "        pl.col(['home_team', 'away_team']).str.replace('L.A.', 'LA', literal=True)\n",
        "    )\n",
        "    ## Remove games listed twice\n",
        "    .unique(subset = 'game_id', keep = 'first', maintain_order=True)\n",
        "    ## Remove games missing refrees\n",
        "    .drop_nulls(subset = ['official1', 'official2', 'official3'])\n",
        "    ## Drop 4th referee column (empty during reg season)\n",
        "    .drop(['official4', 'official4_code', 'official4_JNum'])\n",
        ")\n",
        "games"
      ],
      "id": "0a4ce198",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Matching Referee Stats to Games File - Fixing Names"
      ],
      "id": "f2a57c50"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## Referee Name fixed\n",
        "nameFix = {\n",
        "    'J.T. Orr': 'JT Orr',\n",
        "    'Sharae Mitchell': \"Sha'Rae Mitchell\", 'ShaRae Mitchell': \"Sha'Rae Mitchell\",\n",
        "    'Pat OConnell': \"Pat O'Connell\", 'PAT OConnell': \"Pat O'Connell\", \"PAT O'Connell\": \"Pat O'Connell\",\n",
        "    'Cheryl Flores': 'Che Flores',\n",
        "    'Jamahl Ralls': 'JD Ralls',\n",
        "    'CP Painter': 'Chelisa Painter',\n",
        "}\n",
        "refStats = refStats.with_columns(pl.col('referee').replace(nameFix))\n",
        "\n",
        "## One row per referee per game, attaching stats\n",
        "gameRefs = (games\n",
        "    .unpivot(index = ['game_id', 'season'], on = ['official1', 'official2', 'official3'],\n",
        "        variable_name = 'slot', value_name = 'referee')\n",
        "    .with_columns(pl.col('referee').replace(nameFix))\n",
        "    .join(refStats, on = ['season', 'referee'], how = 'left')\n",
        ")\n",
        "## Check - should be 0\n",
        "gameRefs['fouls_per_game'].null_count()"
      ],
      "id": "4f5c0d4e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Average 3 Referees and Attach Games"
      ],
      "id": "fb5923ac"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "crewStats = (gameRefs\n",
        "    .group_by('game_id')\n",
        "    .agg(\n",
        "        crew_fouls_per_game = pl.col('fouls_per_game').mean(),\n",
        "        crew_experience = pl.col('experience').mean(),\n",
        "        crew_foul_diff = pl.col('foul_diff').mean(),\n",
        "        crew_home_win_pct = pl.col('home_win_pct').mean(),\n",
        "    )\n",
        ")\n",
        "\n",
        "## Attaching stats to games _TranslateTable\n",
        "games = games.join(crewStats, on = 'game_id', how = 'left')\n",
        "games"
      ],
      "id": "39210ec3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Attaching Team Fouls File"
      ],
      "id": "01313bb7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "teamFouls = (pl.read_csv(here('Data/nba_team_personal_fouls_per_game_2017_2025.csv'))\n",
        "    .with_columns(pl.col('team').replace({'Okla City': 'Oklahoma City'}))\n",
        ")\n",
        "\n",
        "## Attaching twice (one for home and one for away)\n",
        "games = (games\n",
        "    .join(teamFouls.rename({'team': 'home_team', 'personal_fouls_per_game': 'home_team_fouls'}), on = ['season', 'home_team'], how = 'left')\n",
        "    .join(teamFouls.rename({'team': 'away_team', 'personal_fouls_per_game': 'away_team_fouls'}), on = ['season', 'away_team'], how = 'left')\n",
        ")\n",
        "games\n",
        "\n",
        "## Expecting that 1,230 games from 2025-26 will have blanks for two columns -- because team fouls file stops at 2024-25\n",
        "games.filter(pl.col('home_team_fouls').is_null()).group_by('season').len()"
      ],
      "id": "dd748c8e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Each row is one game with game info (date, season, teams), crew stats (avg of the 3 referees), and home/away team foul avgs.\n",
        "\n",
        "# For Code Below, We Don't Want Pull Data Every Time - Already Ran It Once\n",
        "## Pulling Each Season's Team Fouls"
      ],
      "id": "1238ee64"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# import time\n",
        "# from nba_api.stats.endpoints import leaguegamelog\n",
        "\n",
        "# foulList = []\n",
        "# for year in range(2017, 2026):\n",
        "#     seasonCode = f'{year}-{str(year + 1)[-2:]}' ## nba_api wants '2017-18' not '2017-2018'\n",
        "\n",
        "#     log = leaguegamelog.LeagueGameLog(\n",
        "#         season = seasonCode,\n",
        "#         season_type_all_star= 'Regular Season',\n",
        "#         timeout = 60,\n",
        "#     )\n",
        "\n",
        "#     ## Turn result into polars table\n",
        "#     result = log.get_dict()['resultSets'][0]\n",
        "#     seasonLog = pl.DataFrame(result['rowSet'], schema = result['headers'], orient='row', infer_schema_length=None)\n",
        "#     foulList.append(seasonLog.select('GAME_ID', 'TEAM_ABBREVIATION', 'PF', 'MIN'))\n",
        "#     time.sleep(1) ## 1 second pause so we don't get blocked on NBA StopIteration\n",
        "\n",
        "# ## Stack all seasons and save\n",
        "# gameLogs = pl.concat(foulList)\n",
        "# gameLogs.write_csv(here('Data/nba_team_game_logs.csv'))\n",
        "# gameLogs"
      ],
      "id": "bdca0cd2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Reading Commented Out Above and Saving"
      ],
      "id": "2f812ee1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "gameLogs = pl.read_csv(here('Data/nba_team_game_logs.csv'))\n",
        "gameLogs['MIN'].value_counts().sort('MIN')"
      ],
      "id": "f94df53b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Total Fouls Per Game, Then Join"
      ],
      "id": "b0a3c141"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "totalFouls = (gameLogs\n",
        "    .with_columns(game_id = pl.col('GAME_ID').cast(pl.Int64)) ## 0021700001 --> 21700001\n",
        "    .group_by('game_id')\n",
        "    .agg(\n",
        "        total_fouls = pl.col('PF').sum(),\n",
        "        n_teams = pl.len(), ## about 2 every game\n",
        "        game_minutes = pl.col('MIN').max(),\n",
        "    )\n",
        ")\n",
        "\n",
        "## Attach to games\n",
        "games = games.join(totalFouls, on = 'game_id', how = 'left')\n",
        "games"
      ],
      "id": "460d0c95",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Checks"
      ],
      "id": "7261e502"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## Every game have exactly 2 teams\n",
        "totalFouls['n_teams'].value_counts()"
      ],
      "id": "ab4bacbe",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## How many games didn't get total_fouls\n",
        "games['total_fouls'].null_count()"
      ],
      "id": "60e1eba3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 45 Missing Games (1/2 a Percent)"
      ],
      "id": "baa2e4b0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "games.filter(pl.col('total_fouls').is_null()).group_by('season').len()"
      ],
      "id": "0b52027e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Drop Games, and n_teams Column (Only Needed For One Check)"
      ],
      "id": "2a5a2020"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "games = (games\n",
        "    .drop_nulls(subset = 'total_fouls')\n",
        "    .drop('n_teams')\n",
        ")\n",
        "games"
      ],
      "id": "8e3e945c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The 45 missing games are from 2019-20 (COVID Season) - league shut down\n",
        "\n",
        "## Team Season Avg From gameLogs"
      ],
      "id": "59420e79"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "teamSeasonFouls = (gameLogs\n",
        "    ## Get season from game ID\n",
        "    .with_columns(start_year = 2000 + (pl.col('GAME_ID') // 100000) % 100)\n",
        "    .with_columns(\n",
        "        season = pl.col('start_year').cast(pl.String) + '-' + (pl.col('start_year') + 1).cast(pl.String)\n",
        "    )\n",
        "    ## Average fouls per game for each team in season\n",
        "    .group_by(['season', 'TEAM_ABBREVIATION'])\n",
        "    .agg(team_fouls = pl.col('PF').mean())\n",
        ")\n",
        "teamSeasonFouls"
      ],
      "id": "e445ccb5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Swap Out Old Columns For New"
      ],
      "id": "029d76ed"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "games = (games\n",
        "    .drop(['home_team_fouls', 'away_team_fouls']) ## remove old ones (blanks)\n",
        "    .join(teamSeasonFouls.rename({'TEAM_ABBREVIATION': 'home_team_abbr', 'team_fouls': 'home_team_fouls'}), on = ['season', 'home_team_abbr'], how = 'left')\n",
        "    .join(teamSeasonFouls.rename({'TEAM_ABBREVIATION': 'away_team_abbr', 'team_fouls': 'away_team_fouls'}), on = ['season', 'away_team_abbr'], how = 'left')\n",
        ")\n",
        "games.select(pl.col('home_team_fouls', 'away_team_fouls').null_count())"
      ],
      "id": "f05d55af",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "All files combined into one table (games). There's 10,729 games, each with crew stats, team foul avgs, and total_fouls (target number).\n",
        "\n",
        "## Removing Unuseful Columns"
      ],
      "id": "98b4bf2c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "gamesClean = (games\n",
        "    .with_columns(game_date = pl.col('game_date').str.to_date('%m/%d/%Y')) ## Changing date format\n",
        "    ## Overtime periods and late season\n",
        "    .with_columns(\n",
        "        overtime = ((pl.col('game_minutes') - 240) /25).cast(pl.Int64),\n",
        "        days_left = (pl.col('game_date').max().over('season') - pl.col('game_date')).dt.total_days(),\n",
        "    )\n",
        "    .with_columns(late_season = pl.col('days_left') <= 14)\n",
        "    .select(\n",
        "        'game_id', 'game_date', 'season', 'home_team_abbr', 'away_team_abbr', 'official1', 'official2', 'official3', 'crew_fouls_per_game', 'crew_experience', 'crew_foul_diff', 'crew_home_win_pct', 'home_team_fouls', 'away_team_fouls', 'overtime', 'late_season', 'total_fouls' ## Only keeping useful columns\n",
        "    )\n",
        "    .sort('game_date')\n",
        ")\n",
        "gamesClean.write_parquet(here('Data/nba_games_clean.parquet'))\n",
        "gamesClean"
      ],
      "id": "1d1b010c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# EDA\n",
        "\n",
        "## Histogram of Total Fouls"
      ],
      "id": "5ae180b2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from plotnine import *\n",
        "import pyarrow\n",
        "\n",
        "(ggplot(gamesClean, aes(x = 'total_fouls'))\n",
        "    + geom_histogram(binwidth=1)\n",
        "    + labs(x = 'Total fouls in game', y = 'Number of games', title = 'Distribution of Total Fouls Per Game')\n",
        ")"
      ],
      "id": "d38fd7e0",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Look at Unusual Games"
      ],
      "id": "d32540d7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "gamesClean['total_fouls'].describe()"
      ],
      "id": "b7d2ca30",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Games With Fewest and Most Fouls"
      ],
      "id": "c9a45dc4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## Lowest\n",
        "gamesClean.sort('total_fouls').select('game_date', 'home_team_abbr', 'away_team_abbr', 'total_fouls').head(10)"
      ],
      "id": "0e4dbb7c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## Highest\n",
        "gamesClean.sort('total_fouls', descending=True).select('game_date', 'home_team_abbr', 'away_team_abbr', 'total_fouls').head(10)"
      ],
      "id": "17ee0834",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Fouls Over Time"
      ],
      "id": "4392ba5d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "(ggplot(gamesClean, aes(x = 'season', y = 'total_fouls'))\n",
        "    + geom_boxplot()\n",
        "    + labs(x = 'Season', y = 'Total fouls in game', title = 'Total Fouls Per Game by Season')\n",
        "    + theme(axis_text_x = element_text(rotation = 45, ha = 'right'))\n",
        ")"
      ],
      "id": "83442469",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Does The Crew Actually Matter"
      ],
      "id": "1a7beb27"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "(ggplot(gamesClean, aes(x = 'crew_fouls_per_game', y = 'total_fouls'))\n",
        "    + geom_point(alpha = 0.1)\n",
        "    + geom_smooth(method = 'lm', color = 'red')\n",
        "    + labs(x = 'Crew average fouls per game (season)', y = 'Total fouls in game', title = 'Crew Foul Tendency vs. Total Fouls')\n",
        ")"
      ],
      "id": "71fd2459",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Correlations"
      ],
      "id": "657205f1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "gamesClean.select(\n",
        "    'total_fouls', 'crew_fouls_per_game', 'crew_experience', 'crew_foul_diff',\n",
        "    'crew_home_win_pct', 'home_team_fouls', 'away_team_fouls', 'overtime'\n",
        ").corr()"
      ],
      "id": "d0c813f4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "-------------------------------------\n"
      ],
      "id": "931c977f"
    }
